<mujoco model="push_bot">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" iterations="8"/>
  <custom>
    <numeric data="1000" name="constraint_limit_stiffness"/>
    <numeric data="4000" name="constraint_stiffness"/>
    <numeric data="10" name="constraint_ang_damping"/>
    <numeric data="20" name="constraint_vel_damping"/>
    <numeric data="0.5" name="joint_scale_pos"/>
    <numeric data="0.2" name="joint_scale_ang"/>
    <numeric data="0.0" name="ang_damping"/>
    <numeric data="1" name="spring_mass_scale"/>
    <numeric data="1" name="spring_inertia_scale"/>
    <numeric data="15" name="solver_maxls"/>
  </custom>
  <default>
    <joint armature="0.5" damping="0.8" limited="true"/>
    <geom contype="1" conaffinity="1" condim="3"
          density="8.0" friction="1.2 0.4 0.4"/>
  </default>
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 -1.3"
           directional="true" exponent="1" pos="0 0 6"/>
    <!-- The agent and puck are already constrained to the xy plane by slide
         joints.  Disabling floor contact avoids an unphysical static-friction
         lock: neither body has a vertical or rotational degree of freedom
         with which to resolve that contact.  Agent-to-puck and wall contacts
         remain enabled. -->
    <geom name="floor" type="plane" pos="0 0 0" size="20 20 1"
          contype="0" conaffinity="0" friction="0 0 0"
          rgba="0.85 0.85 0.85 1"/>

    <body name="agent" pos="0 0 0.35">
      <joint name="agent_x" type="slide" axis="1 0 0"
             range="-5 5" damping="1.0"/>
      <joint name="agent_y" type="slide" axis="0 1 0"
             range="-5 5" damping="1.0"/>
      <geom name="agent_geom" type="sphere" size="0.35"
            density="12" rgba="0.15 0.35 0.85 1"/>
    </body>

    <body name="puck" pos="0 0 0.35">
      <joint name="puck_x" type="slide" axis="1 0 0"
             range="-5 5" damping="1.2"/>
      <joint name="puck_y" type="slide" axis="0 1 0"
             range="-5 5" damping="1.2"/>
      <geom name="puck_geom" type="sphere" size="0.42"
            density="5" rgba="0.95 0.65 0.10 1"/>
    </body>

    <body name="target" pos="0 0 0.02">
      <joint name="target_x" type="slide" axis="1 0 0"
             range="-5 5" damping="0"/>
      <joint name="target_y" type="slide" axis="0 1 0"
             range="-5 5" damping="0"/>
      <geom name="target_geom" type="cylinder" size="0.55 0.015"
            contype="0" conaffinity="0" density="0.001"
            rgba="0.15 0.75 0.25 0.55"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="agent_force_x" joint="agent_x" gear="8 0 0"
           ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="agent_force_y" joint="agent_y" gear="8 0 0"
           ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
